{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebSearch(*",
      "WebFetch",
      "WebFetch(*",
      "Read(**",
      "Write(outputs/**)",
      "Edit(outputs/**)",
      "Bash(python .claude/skills/autosource/postprocess.py *)",
      "Skill(autosource)",
      "Skill(autosource:*)",
      "Skill(autosource-search)"
    ],
    "additionalDirectories": [
      ".claude/skills"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/skills/autosource/log_tool.py outputs/search_log.jsonl"
          }
        ]
      }
    ]
  }
}
