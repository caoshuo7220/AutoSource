{
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebSearch(*",
      "Read(**",
      "Write(outputs/**)",
      "Edit(outputs/**)",
      "Bash(python .claude/skills/autosource/scripts/postprocess.py *)",
      "Skill(autosource)",
      "Skill(autosource:*)"
    ],
    "deny": [
      "Read(outputs/**)",
      "Glob(outputs*)"
    ],
    "additionalDirectories": [
      ".claude/skills"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/skills/autosource/scripts/log_tool.py"
          }
        ]
      }
    ]
  }
}
